# /etc/ccproxy/env — copy to /etc/ccproxy/env, chmod 600, owner = service user.
#
# Keep this file minimal. ccproxy's behavior lives in config.yaml at
# $CCPROXY_STATE/config.yaml (or wherever $CCPROXY_CONFIG points). Env vars
# here are only for deploy-time wiring (bind addrs, state dir, log format)
# and the optional first-boot token seed.
#
# Env vars always win over equivalent YAML values. The systemd unit already
# sets CCPROXY_STATE and CCPROXY_CONFIG — override them here only if you
# run ccproxy outside /var/lib/ccproxy and /etc/ccproxy.

# OPTIONAL. If set AND the token DB is empty on first boot, seed this bearer
# (must be in ccp_<prefix>_<secret> format). Leave empty to let ccproxy
# auto-mint a fresh bearer — it prints once in a startup banner visible
# via `journalctl -u ccproxy`.
# CCPROXY_TOKEN=

# Where the HTTP listener binds. Default :4141.
CCPROXY_LISTEN=0.0.0.0:4141

# Optional Prometheus metrics listener (no auth — keep loopback / private LAN).
# Leave unset to disable /metrics entirely.
# CCPROXY_METRICS_LISTEN=127.0.0.1:9101

# Override the defaults set by the systemd unit if needed.
# CCPROXY_STATE=/var/lib/ccproxy
# CCPROXY_CONFIG=/etc/ccproxy/config.yaml

# Log format: json (default under systemd/Docker) or text (default on a TTY).
# Force text for grep-friendly output under journald, or json for a TTY
# debug session you plan to pipe through jq.
# CCPROXY_LOG_FORMAT=json
